#!/usr/bin/env bash
# pre-push hook for brutedash -- runs the release gate over the pushed commits.
#
# Installed by scripts/install-hooks.sh (copied to .git/hooks/pre-push).
# Git invokes it with lines on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# It builds ONE unified diff of everything the push would add, exports it as
# RELEASE_GATE_DIFF, and execs scripts/release-gate.sh. A non-zero gate
# exit rejects the push. Fail closed: if the push range cannot be
# determined, the push is rejected rather than silently un-gated.
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "pre-push: cannot find repo root; push rejected" >&2; exit 1; }

TMP="$(mktemp)" || { echo "pre-push: mktemp failed; push rejected" >&2; exit 1; }
trap 'rm -f "$TMP"' EXIT
: > "$TMP"

ZERO="0000000000000000000000000000000000000000"
have_range=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    if [ "$local_sha" = "$ZERO" ]; then
        continue  # branch deleted -- nothing to gate
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch: diff each commit not on any remote-tracking branch.
        # (git show on a root commit diffs against the empty tree, so the
        # first commit is covered too. Merge commits show a combined diff --
        # the gate's suite + tree-wide gitleaks still run on those.)
        while IFS= read -r c; do
            git show --format= --patch --no-ext-diff --no-color "$c" \
                >> "$TMP" 2>/dev/null || {
                echo "pre-push: cannot diff commit $c; push rejected" >&2
                exit 1; }
            have_range=1
        done < <(git rev-list "$local_sha" --not --remotes --reverse 2>/dev/null)
    else
        git diff --no-ext-diff --no-color "$remote_sha...$local_sha" \
            >> "$TMP" 2>/dev/null || {
            echo "pre-push: cannot diff $remote_sha...$local_sha;" \
                 "push rejected" >&2
            exit 1; }
        have_range=1
    fi
done

if [ "$have_range" = 0 ]; then
    echo "pre-push: no new commits to gate; running tree checks only"
fi

RELEASE_GATE_DIFF="$TMP" exec "$ROOT/scripts/release-gate.sh"
