# wifimon.cap -- TEMPLATE for brutedash whole-network view.
#
# Do NOT edit this file with your own interface in it: the interface name
# is different on every machine (on Windows it is a \Device\NPF_{GUID}
# string unique to each PC). Instead, generate your own copy:
#
#     python -m netmon.relay --write
#
# That writes netmon/wifimon.local.cap (git-ignored) with this machine's
# interface and subnet filled in, and prints the exact command to run.
#
# WHAT IT DOES: ARP-spoofs your own LAN so this machine relays traffic
# between your devices and the router. brutedash, sniffing the Wi-Fi
# interface, then sees every device's conversations -- phones, TV,
# consoles -- not just this PC's.
#
# ONLY run this on a network you own. While it runs, this PC is the LAN's
# man in the middle: if the PC sleeps, reboots, or bettercap dies, the other
# devices lose internet until their ARP tables recover (usually < 1 min).
#
# STOP: type `quit` in the bettercap console (it restores ARP tables on exit).
#
# brutedash's ARP-spoof detector is built to notice this: if you want the
# dashboard to flag your own relay as a live self-test, leave the
# arp_spoof rule enabled.

set arp.spoof.fullduplex true
set arp.spoof.targets <YOUR_LAN_SUBNET>   # e.g. 192.168.1.0/24 -- filled in by `python -m netmon.relay --write`
arp.spoof on
